  }

  aBox.addEventListener('input', (e) => {
    const el = e.target.closest('[data-k]');
    const det = el && el.closest('[data-i]');
    if (!det) return;
    const i = +det.dataset.i, k = el.dataset.k;
    work[i][k] = k === 'price' ? (Number(el.value) || 0) : el.value;
    saveWork();
    const b = work[i];
    $('[data-sum]', det).textContent = b.name || 'New bear';
    $('[data-sub]', det).textContent = `${b.status} · $${b.price}`;
  });

  aBox.addEventListener('click', async (e) => {
    const t = e.target.closest('[data-act],[data-aclose]');
    if (!t) return;
    if (t.hasAttribute('data-aclose')) { aDlg.close(); return; }
    const act = t.dataset.act;
    const det = t.closest('[data-i]');
    const i = det ? +det.dataset.i : -1;
    if (act === 'logout') { setAdmin(false); aDlg.close(); location.reload(); return; }
    if (act === 'add') {
      work.push({ id: 'bear-' + Date.now().toString(36), number: String(Date.now()).slice(-4), name: 'New bear', price: 70,
        traits: '', blurb: '', coat: '', height: '10 inches', born: '', stitched_by: '',
        color_body: '#DFAE5C', color_ear: '#C0913A', color_nose: '#7A4B33', status: 'available' });
      openIdx = work.length - 1; rerenderList(); saveWork(); return;
    }
    if (act === 'dup' && i >= 0) {
      const c = clone(work[i]); c.id = 'bear-' + Date.now().toString(36); c.name += ' copy'; c.status = 'available';
      work.splice(i + 1, 0, c); openIdx = i + 1; rerenderList(); saveWork(); return;
    }
    if (act === 'del' && i >= 0) {
      if (!confirm(`Delete "${work[i].name}"?`)) return;
      work.splice(i, 1); openIdx = -1; rerenderList(); saveWork(); return;
    }
    if (act === 'code') {
      const ta = $('#aCode'); ta.hidden = false; ta.value = bearsCode(); ta.select();
      try { await navigator.clipboard.writeText(ta.value); aStatus('Code copy ho gaya.', 'ok'); }
      catch { aStatus('Code neeche hai, select karke copy karo.', 'ok'); }
      return;
    }
    if (act === 'download') {
      try {
        const res = await fetch(location.href.split('#')[0], { cache: 'no-store' });
        if (!res.ok) throw new Error('fetch failed');
        const out = injectBears(await res.text());
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([out], { type: 'text/html' }));
        a.download = 'index.html';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(a.href), 1000);
        aStatus('index.html download ho gayi. Ab isay GitHub par upload karo.', 'ok');
      } catch {
        aStatus('Download yahan nahi chal saka. "Show and copy code" use karo.', 'bad');
      }
      return;
    }
    if (act === 'hash') {
      const v = $('#aNewPass').value;
      if (v.length < 10) { aStatus('Password kam az kam 10 characters ka rakho.', 'bad'); return; }
      try { $('#aHashOut').value = `const ADMIN_HASH = '${await sha256(v)}';`; $('#aHashOut').select(); aStatus('Line tayyar hai, copy karo.', 'ok'); }
      catch { aStatus('Hash banane ke liye site https par kholo.', 'bad'); }
      return;
    }
    if (act === 'discard') {
      if (!confirm('Draft hata kar file wali list par wapas jayen?')) return;
      lsDel(DKEY); location.reload(); return;
    }
    if (act === 'clearres') {
      lsDel(RKEY); aStatus('Reserved clear ho gaye. Page reload karo.', 'ok');
    }
  });

  aDlg.addEventListener('click', (e) => { if (e.target === $('#adminWrap')) aDlg.close(); });
  aDlg.addEventListener('close', () => {
    if (location.hash === '#admin') history.replaceState(null, '', location.pathname + location.search);
  });
  window.addEventListener('hashchange', () => { if (location.hash === '#admin') openAdmin(); });
  setTimeout(() => { if (location.hash === '#admin') openAdmin(); }, 0);

  // ---------- go ----------
  renderHero();
  renderGrid();
})();
</script>
</body>
</html>
